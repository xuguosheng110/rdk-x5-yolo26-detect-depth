[Unit]
Description=RDK X5 YOLO26 detection and relative depth
After=local-fs.target
StartLimitIntervalSec=0
[Service]
Type=simple
WorkingDirectory=/app/rdk-x5-vision
ExecStart=/usr/bin/python3 -u /app/rdk-x5-vision/scripts/run.py
Restart=always
RestartSec=3
TimeoutStopSec=10
[Install]
WantedBy=multi-user.target
